struct Universe {
    epochs: Vec<&'static str>,
    pulses: usize,
}

impl Universe {
    fn new() -> Self {
        Universe {
            epochs: vec!["Silence", "Pulse", "Collapse", "Becoming", "Expansion"],
            pulses: 0,
        }
    }

    fn unfold(&mut self) {
        for epoch in &self.epochs {
            println!("Epoch: {}", epoch);
            self.pulses += 1;
            match *epoch {
                "Silence" => self.init(),
                "Pulse" => self.kernel(),
                "Collapse" => self.runtime(),
                "Becoming" => self.userland(),
                "Expansion" => self.exit(),
                _ => (),
            }
        }
    }

    fn init(&self) {
        println!("Zero-state. Time unravels.");
    }

    fn kernel(&self) {
        println!("Beat. Thump. Beat. Thump.");
    }

    fn runtime(&self) {
